# API Configuration
# Copy this file to .env and fill in your actual keys

# CoinGecko (free tier available)
# Get free key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=free

# Glassnode (on-chain metrics, paid)
# Get key at: https://glassnode.com/
GLASSNODE_API_KEY=your_glassnode_key_here

# Binance (optional, for live trading)
# Get keys at: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_key_here
BINANCE_API_SECRET=your_binance_secret_here

# Trading Parameters
INITIAL_CAPITAL=10000
TRADING_PAIR=BTC/USD
MAX_POSITION_SIZE=0.10  # 10% of portfolio
DAILY_LOSS_LIMIT=-0.05   # -5% stop loss
LEVERAGE=1.0             # No leverage initially

# TDA Parameters
WINDOW_SIZE=10          # days
EMBEDDING_DIMENSION=5   # dimensions
C1_THRESHOLD_STD=2.0    # std deviations for signal
ENTROPY_CONFIDENCE=0.7  # minimum confidence

# Data Parameters
LOOKBACK_DAYS=365       # historical data
DATA_INTERVAL=1d        # daily (or 1h, 4h, etc.)

# Risk Management
TRADE_FEE=0.001         # 0.1% per trade
RF_RATE=0.02            # risk-free rate for Sharpe
MAX_DRAWDOWN=-0.20      # -20% global stop
